http:
  routers:
    zabbix-web:
      rule: "Host(`{{ zabbix_web_hostname }}`)"
      entryPoints: [websecure]
      service: zabbix-web
      tls: {}
  services:
    zabbix-web:
      loadBalancer:
        servers:
          - url: http://zabbix_app_frontend:8080
tcp:
  routers:
    zabbix-sni:
      rule: "HostSNI(`{{ zabbix_tcp_hostname }}`)"
      entryPoints: [zabbix]
      service: zabbix-server
      tls:
        passthrough: true
    zabbix-tls-default:
      rule: "HostSNI(`*`)"
      entryPoints: [zabbix]
      service: zabbix-server
      tls:
        passthrough: true
    zabbix-tcp:
      rule: "HostSNI(`*`)"
      entryPoints: [zabbix]
      service: zabbix-server
  services:
    zabbix-server:
      loadBalancer:
        healthCheck:
          interval: 5s
          timeout: 2s
        servers:
{% for n in range(1, 4) %}
          - address: "zabbix_app_server{{ n }}:{{ 10050 + n }}"
{% endfor %}
tls:
  certificates:
    - certFile: /run/secrets/traefik_tls_cert
      keyFile: /run/secrets/traefik_tls_key
