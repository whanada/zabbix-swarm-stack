version: '3.8'
# Database services use dedicated, pre-mounted filesystems on each worker.
services:
{% for n in range(1, 4) %}
  etcd{{ n }}:
    image: {{ etcd_image }}
    command: [etcd, --name, etcd{{ n }}, --data-dir, /etcd-data, --listen-client-urls, 'http://0.0.0.0:2379', --advertise-client-urls, 'http://etcd{{ n }}:2379', --listen-peer-urls, 'http://0.0.0.0:2380', --initial-advertise-peer-urls, 'http://etcd{{ n }}:2380', --initial-cluster, 'etcd1=http://etcd1:2380,etcd2=http://etcd2:2380,etcd3=http://etcd3:2380', --initial-cluster-state, new, --initial-cluster-token, zabbix-etcd]
    volumes: ['/var/lib/zabbix-ha/etcd:/etcd-data']
    networks: [backend]
    deploy:
      placement:
        constraints: ['node.labels.zabbix.slot == {{ n }}']

  db{{ n }}:
    image: {{ patroni_image }}
    entrypoint: [/bin/sh, -ec]
    command:
      - |
        export PATRONI_SUPERUSER_PASSWORD="$$(cat /run/secrets/patroni_superuser_password)"
        export PATRONI_REPLICATION_PASSWORD="$$(cat /run/secrets/patroni_replication_password)"
        exec /opt/patroni/bin/patroni /etc/patroni/patroni.yml
    environment:
      PATRONI_NAME: db{{ n }}
      PATRONI_SUPERUSER_USERNAME: postgres
      PATRONI_REPLICATION_USERNAME: replicator
      PATRONI_POSTGRESQL_LISTEN: '0.0.0.0:5432'
      PATRONI_POSTGRESQL_CONNECT_ADDRESS: 'db{{ n }}:5432'
      PATRONI_RESTAPI_LISTEN: '0.0.0.0:8008'
      PATRONI_RESTAPI_CONNECT_ADDRESS: 'db{{ n }}:8008'
    configs:
      - source: patroni_config
        target: /etc/patroni/patroni.yml
    secrets: [patroni_superuser_password, patroni_replication_password]
    volumes: ['/var/lib/zabbix-ha/postgres:/var/lib/postgresql/data']
    networks: [backend]
    deploy:
      placement:
        constraints: ['node.labels.zabbix.slot == {{ n }}']
{% endfor %}
  db-haproxy:
    image: {{ haproxy_image }}
    configs:
      - source: haproxy_config
        target: /usr/local/etc/haproxy/haproxy.cfg
    networks: [backend]
    deploy:
      replicas: 2
      placement:
        constraints: ['node.role == worker']
        max_replicas_per_node: 1

{% for n in range(1, 3) %}
  pgbouncer{{ n }}:
    image: {{ pgbouncer_image }}
    entrypoint: [/bin/sh, -ec]
    command:
      - |
        export DB_USER="$$(cat /run/secrets/zabbix_db_user)"
        export DB_PASSWORD="$$(cat /run/secrets/zabbix_db_password)"
        printf '"zbx_stats" "%s"\n' "$$(cat /run/secrets/metrics_pgbouncer_password)" > /etc/pgbouncer/userlist.txt
        exec /entrypoint.sh /usr/bin/pgbouncer /etc/pgbouncer/pgbouncer.ini
    environment:
      DB_HOST: db-haproxy
      DB_PORT: '5432'
      DB_NAME: zabbix
      AUTH_TYPE: scram-sha-256
      POOL_MODE: session
      STATS_USERS: zbx_stats
      MAX_CLIENT_CONN: '500'
      DEFAULT_POOL_SIZE: '40'
    secrets: [zabbix_db_user, zabbix_db_password, metrics_pgbouncer_password]
    networks: [backend]
    deploy:
      placement:
        constraints: ['node.labels.zabbix.slot == {{ n }}']
{% endfor %}

  pgbouncer-router:
    image: {{ haproxy_image }}
    configs:
      - source: pgbouncer_haproxy_config
        target: /usr/local/etc/haproxy/haproxy.cfg
    networks: [backend]
    deploy:
      replicas: 2
      placement:
        constraints: ['node.role == worker']
        max_replicas_per_node: 1

networks:
  backend:
    external: true
    name: zabbix_backend
configs:
  patroni_config:
    external: true
    name: {{ patroni_config_name }}
  haproxy_config:
    external: true
    name: {{ haproxy_config_name }}
  pgbouncer_haproxy_config:
    external: true
    name: {{ pgbouncer_haproxy_config_name }}
secrets:
  patroni_superuser_password:
    external: true
  patroni_replication_password:
    external: true
  zabbix_db_user:
    external: true
  zabbix_db_password:
    external: true
  metrics_pgbouncer_password:
    external: true
