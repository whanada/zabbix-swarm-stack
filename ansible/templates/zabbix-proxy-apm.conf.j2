# Zabbix 8 proxy with --with-apm; data source configured globally in Zabbix.
StartAPMCollector={{ 1 if zabbix_apm_enabled | default(false) | bool else 0 }}
StartTelemetryQueryPollers={{ zabbix_proxy_telemetry_query_pollers | default(1) | int }}
APMListenIP={{ zabbix_apm_listen_ip | default('0.0.0.0') }}
APMListenPort={{ zabbix_apm_listen_port | default(4317) | int }}
{% if zabbix_apm_tls_enabled | default(false) | bool %}
APMTLSCAFile={{ zabbix_apm_tls_ca_file }}
APMTLSCertFile={{ zabbix_apm_tls_cert_file }}
APMTLSKeyFile={{ zabbix_apm_tls_key_file }}
{% endif %}
