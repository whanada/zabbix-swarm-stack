# Stack and networks
STACK_NAME=zabbix
ZABBIX_NETWORK=zabbix_backend
TRAEFIK_NETWORK=traefik_public
TZ=America/Sao_Paulo

# Pinned images (review and update deliberately)
TIMESCALE_IMAGE=timescale/timescaledb:2.27.2-pg16
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.2-p0
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:ubuntu-7.0.28
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:ubuntu-7.0.28
ZABBIX_WEBSERVICE_IMAGE=zabbix/zabbix-web-service:ubuntu-7.0.28
ZABBIX_PROXY_IMAGE=zabbix/zabbix-proxy-sqlite3:ol-7.0.28
SELENIUM_IMAGE=selenium/standalone-chrome:4.44.0-20260505

# Existing external Docker Swarm secrets (names only; never put secret values here)
POSTGRES_ADMIN_USER_SECRET=zabbix_postgres_admin_user
POSTGRES_ADMIN_PASSWORD_SECRET=zabbix_postgres_admin_password
ZABBIX_DB_USER_SECRET=zabbix_db_user
ZABBIX_DB_PASSWORD_SECRET=zabbix_db_password
ZABBIX_CA_SECRET=zabbix_ca
ZABBIX_SERVER_CERT_SECRET=zabbix_server_cert
ZABBIX_SERVER_KEY_SECRET=zabbix_server_key
ZABBIX_PROXY_CERT_SECRET=zabbix_proxy_cert
ZABBIX_PROXY_KEY_SECRET=zabbix_proxy_key

# PostgreSQL / TimescaleDB
POSTGRES_DB=zabbix
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_WAL_LEVEL=logical
POSTGRES_MAX_WAL_SENDERS=10
POSTGRES_MAX_REPLICATION_SLOTS=10
POSTGRES_MAX_LOGICAL_REPLICATION_WORKERS=8
POSTGRES_MAX_SYNC_WORKERS_PER_SUBSCRIPTION=4
POSTGRES_MAX_WORKER_PROCESSES=32
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_STATEMENT_TIMEOUT=5min
TIMESCALE_TUNE_MEMORY=16GB
TIMESCALE_TUNE_CPUS=8
TIMESCALE_CPU_LIMIT=8
TIMESCALE_MEMORY_LIMIT=16G
TIMESCALE_CPU_RESERVATION=2
TIMESCALE_MEMORY_RESERVATION=4G
TIMESCALE_PRIMARY_DATA_PATH=/var/lib/zabbix/timescaledb-primary
TIMESCALE_SUBSCRIBER_DATA_PATH=/var/lib/zabbix/timescaledb-subscriber
TIMESCALE_PRIMARY_NODE_LABEL=primary
TIMESCALE_SUBSCRIBER_NODE_LABEL=subscriber

# PgBouncer (session mode is the compatibility-first default for Zabbix)
PGBOUNCER_DB_HOST=timescaledb-primary
PGBOUNCER_DB_PORT=5432
PGBOUNCER_POOL_MODE=session
PGBOUNCER_MAX_CLIENT_CONN=3000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_TIMEOUT=5
PGBOUNCER_MAX_PREPARED_STATEMENTS=100
PGBOUNCER_REPLICAS=2
PGBOUNCER_CPU_LIMIT=2
PGBOUNCER_MEMORY_LIMIT=1G

# Logical PUB/SUB for ordinary public-schema tables only. Timescale hypertable
# chunks/DDL require physical replication for a complete standby.
REPLICATION_ENABLED=true
REPLICATION_PUBLICATION=zabbix_publication
REPLICATION_SUBSCRIPTION=zabbix_subscription
KEEP_REPLICATION_DUMP=false

# Zabbix HA node identity and Swarm placement
ZABBIX_HA1_REPLICAS=1
ZABBIX_HA2_REPLICAS=1
ZABBIX_HA1_HOSTNAME=zabbix-ha1.example.com
ZABBIX_HA2_HOSTNAME=zabbix-ha2.example.com
ZABBIX_HA1_NODEADDRESS=server-ha1:10051
ZABBIX_HA2_NODEADDRESS=server-ha2:10051
ZABBIX_HA1_NODE_LABEL=ha1
ZABBIX_HA2_NODE_LABEL=ha2
ZABBIX_HA1_PUBLISHED_PORT=10051
ZABBIX_HA2_PUBLISHED_PORT=10251
ZABBIX_SERVER_CPU_LIMIT=24
ZABBIX_SERVER_MEMORY_LIMIT=28G
ZABBIX_SERVER_CPU_RESERVATION=4
ZABBIX_SERVER_MEMORY_RESERVATION=8G
ZABBIX_SNMP_TRAPS_PATH=/var/lib/zabbix/snmptraps
ZABBIX_MIBS_PATH=/var/lib/zabbix/mibs

# Zabbix server tuning copied from the supplied production definitions
ZBX_WEBSERVICEURL=http://webservice:10053/report
ZBX_WEBDRIVERURL=http://selenium:4444
ZBX_STARTREPORTWRITERS=3
ZBX_CACHESIZE=8G
ZBX_HISTORYCACHESIZE=2G
ZBX_STARTPOLLERS=500
ZBX_STARTIPMIPOLLERS=5
ZBX_STARTPREPROCESSORS=300
ZBX_STARTPOLLERSUNREACHABLE=200
ZBX_STARTHISTORYPOLLERS=500
ZBX_STARTTRAPPERS=15
ZBX_STARTHTTPPOLLERS=100
ZBX_STARTESCALATORS=5
ZBX_STARTVMWARECOLLECTORS=150
ZBX_VMWAREFREQUENCY=60
ZBX_VMWAREPERFFREQUENCY=60
ZBX_VMWARECACHESIZE=2G
ZBX_VMWARETIMEOUT=60
ZBX_STARTDBSYNCERS=50
ZBX_HISTORYINDEXCACHESIZE=2G
ZBX_HISTORYSTORAGEDATEINDEX=0
ZBX_TRENDCACHESIZE=2G
ZBX_VALUECACHESIZE=2G
ZBX_STARTLLDPROCESSORS=20
ZBX_STARTPINGERS=200
ZBX_TIMEOUT=20
ZBX_STARTPROXYPOLLERS=5
ZBX_DEBUGLEVEL=2
ZBX_HOUSEKEEPINGFREQUENCY=0
ZBX_MAXHOUSEKEEPERDELETE=2000
ZBX_ENABLE_SNMP_TRAPS=true
ZBX_STARTALERTERS=5
ZBX_STARTDISCOVERERS=20
ZBX_STARTBROWSERPOLLERS=5
ZBX_STARTSNMPPOLLERS=10
ZBX_STARTODBCPOLLERS=5
ZBX_TLSACCEPT=cert

# Frontend and Traefik
ZABBIX_FRONTEND_REPLICAS=2
ZABBIX_FRONTEND_HOST=zabbix.example.com
ZABBIX_FRONTEND_NAME=SP01
ZABBIX_FRONTEND_CPU_LIMIT=8
ZABBIX_FRONTEND_MEMORY_LIMIT=1G
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Web service / Selenium
WEBSERVICE_REPLICAS=1
WEBSERVICE_ALLOWED_IP=10.0.0.0/8
WEBSERVICE_CPU_LIMIT=2
WEBSERVICE_MEMORY_LIMIT=1G
SELENIUM_REPLICAS=1
SELENIUM_CPU_LIMIT=2
SELENIUM_MEMORY_LIMIT=2G
SELENIUM_SHM_SIZE_BYTES=2147483648

# Optional SQLite proxy
PROXY_REPLICAS=1
PROXY_HOSTNAME=zabbix-proxy1.example.com
PROXY_NODE_LABEL=proxy1
PROXY_DATA_PATH=/var/lib/zabbix/proxy001
PROXY_SERVER_HOSTS='server-ha1:10051;server-ha2:10051'
PROXY_PUBLISHED_SERVER_PORT=10011
PROXY_PUBLISHED_AGENT_PORT=10010
PROXY_CPU_LIMIT=8
PROXY_MEMORY_LIMIT=5G
PROXY_TIMEOUT=5
PROXY_CONFIG_FREQUENCY=60
PROXY_DATA_SENDER_FREQUENCY=1
PROXY_STARTPOLLERSUNREACHABLE=50
PROXY_STARTPOLLERS=200
PROXY_STARTHTTPPOLLERS=200
PROXY_CACHESIZE=1G
PROXY_STARTDBSYNCERS=2
PROXY_HISTORYCACHESIZE=1G
PROXY_HISTORYINDEXCACHESIZE=1G
PROXY_STARTIPMIPOLLERS=5
PROXY_STARTPREPROCESSORS=200
PROXY_STARTTRAPPERS=15
PROXY_STARTVMWARECOLLECTORS=50
PROXY_VMWAREFREQUENCY=60
PROXY_VMWAREPERFFREQUENCY=60
PROXY_VMWARECACHESIZE=1G
PROXY_VMWARETIMEOUT=60
PROXY_STARTPINGERS=100
PROXY_HOUSEKEEPINGFREQUENCY=0

# Certificate generation
CERT_OUTPUT_DIR=./certs
CERT_COUNTRY=BR
CERT_STATE=Goias
CERT_LOCALITY=Goiania
CERT_ORGANIZATION=ExampleOrg
CERT_ORGANIZATIONAL_UNIT=IT
CERT_CA_CN=Zabbix-CA
CERT_SERVER_CN=zabbix-ha1.example.com
CERT_SERVER_SAN=DNS:zabbix-ha1.example.com,DNS:zabbix-ha2.example.com,DNS:server-ha1,DNS:server-ha2
CERT_PROXY_CN=zabbix-proxy1.example.com
CERT_PROXY_SAN=DNS:zabbix-proxy1.example.com
CERT_DAYS=3650
