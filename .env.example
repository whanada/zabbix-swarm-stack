# AWS Swarm configuration. Copy to .env and keep it out of Git.
# Load with: set -a; source .env; set +a

# Pinned images; verify compatibility before changing versions.
TIMESCALE_BASE=timescale/timescaledb:2.29.0-pg17
PATRONI_VERSION=4.1.5
IMAGE_REVISION=r2
ZABBIX_VERSION=8.0.0
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.21
AWS_REGION=us-east-1
ECR_REGISTRY=753226848084.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=whanada/zabbix-ha-stack
PATRONI_IMAGE=753226848084.dkr.ecr.us-east-1.amazonaws.com/whanada/zabbix-ha-stack:2.29.0-pg17-patroni4.1.5-r2-zabbix8.0.0
HAPROXY_IMAGE=haproxy:3.0.11-alpine
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.2-p0
CLICKHOUSE_SERVER_IMAGE=clickhouse/clickhouse-server:26.8.40.7
CLICKHOUSE_KEEPER_IMAGE=clickhouse/clickhouse-keeper:26.8.40.7
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:ubuntu-8.0.0
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:ubuntu-8.0.0
ZABBIX_WEBSERVICE_IMAGE=zabbix/zabbix-web-service:ubuntu-8.0.0
ZABBIX_PROXY_IMAGE=zabbix/zabbix-proxy-sqlite3:ubuntu-8.0.0
SELENIUM_IMAGE=selenium/standalone-chrome:4.44.0-20260505
TRAEFIK_IMAGE=traefik:v3.7.7
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
PGBOUNCER_EXPORTER_IMAGE=prometheuscommunity/pgbouncer-exporter:v0.12.1
PGSCV_IMAGE=cherts/pgscv:v0.15.3
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.165.0
PROCESS_EXPORTER_IMAGE=ncabatoff/process-exporter:0.8.7
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6

# These settings apply to all three HA servers.
TZ=America/Sao_Paulo
POSTGRES_DB=zabbix
ZBX_WEBSERVICEURL=http://webservice:10053/report
ZBX_WEBDRIVERURL=http://selenium:4444
ZBX_STARTREPORTWRITERS=1
ZBX_CACHESIZE=128M
ZBX_HISTORYCACHESIZE=64M
ZBX_STARTPOLLERS=5
ZBX_STARTIPMIPOLLERS=0
ZBX_STARTPREPROCESSORS=3
ZBX_STARTPOLLERSUNREACHABLE=1
ZBX_STARTHISTORYPOLLERS=5
ZBX_STARTTRAPPERS=5
ZBX_STARTHTTPPOLLERS=2
ZBX_STARTESCALATORS=1
ZBX_STARTVMWARECOLLECTORS=0
ZBX_VMWAREFREQUENCY=60
ZBX_VMWAREPERFFREQUENCY=60
ZBX_VMWARECACHESIZE=16M
ZBX_VMWARETIMEOUT=60
ZBX_STARTDBSYNCERS=4
ZBX_HISTORYINDEXCACHESIZE=32M
ZBX_HISTORYSTORAGEDATEINDEX=0
ZBX_TRENDCACHESIZE=32M
ZBX_VALUECACHESIZE=64M
ZBX_STARTLLDPROCESSORS=2
ZBX_STARTPINGERS=1
ZBX_TIMEOUT=20
ZBX_STARTPROXYPOLLERS=1
ZBX_DEBUGLEVEL=2
ZBX_HOUSEKEEPINGFREQUENCY=1
ZBX_MAXHOUSEKEEPERDELETE=5000
ZBX_ENABLE_SNMP_TRAPS=true
ZBX_STARTALERTERS=3
ZBX_STARTDISCOVERERS=1
ZBX_STARTBROWSERPOLLERS=1
ZBX_STARTSNMPPOLLERS=1
ZBX_STARTODBCPOLLERS=1
ZBX_TLSACCEPT=cert
ZBX_STARTTELEMETRYQUERYPOLLERS=1

# Certificates and passwords are managed in AWS Secrets Manager.
ZABBIX_SECRET_PREFIX=zabbix-ha
ZABBIX_APM_ENABLED=false
ZABBIX_PROXY_HOST=zabbix-proxy001
# Configure hostnames in the environment or GitHub variables:
# ZABBIX_FRONTEND_HOST=zabbix.example.com
# ZABBIX_TCP_HOST=zabbix-tcp.example.com
